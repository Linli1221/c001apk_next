<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置（WebView 及所有走系统默认校验的网络栈都遵循本配置）。

  1. 信任锚 = **仅系统 CA**。
     - targetSdk >= 24 时，默认就不信任「用户手动安装的 CA」，
       所以抓包工具证书（Charles / Fiddler / mitmproxy）对 WebView 同样无效。
     - 这里**刻意不放内置的 Mozilla CA**：Android 的 Conscrypt 规定
       「App 自己提供的信任锚不允许使用 SHA-1 签名」，而酷安全站
       （api/www/m/account.coolapk.com）的证书链末端都带着
       DigiCert Global Root CA（SHA-1 自签）这个历史遗留根，
       一旦把内置 CA 也列为锚点，整条链会被 Conscrypt 拒绝、页面全打不开。
       内置 Mozilla CA 库改由 OkHttp 层使用（见 util/SslVerify.kt）：
       那里用「平台校验 + 锚点必须在 Mozilla 库中」的方式做更严格的限制。
  2. cleartextTrafficPermitted="true"：保留 http 明文访问（与原 usesCleartextTraffic 行为一致）。
  3. debug-overrides 显式覆盖：debug 构建默认会信任用户安装的 CA，这里关掉，避免调试期行为与正式版不一致。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </debug-overrides>
</network-security-config>
